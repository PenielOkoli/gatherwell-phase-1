# Demo mode is safe to deploy without any provider credentials.
AI_MODE=demo
# Server-only: never prefix any of these with NEXT_PUBLIC_.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Required for live /api/assistant requests; use a random 32+ character token.
# Keep this in a server-side API client, never the public browser UI.
AI_ACCESS_TOKEN=
